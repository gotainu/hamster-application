rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPersonalityReportId(reportId) {
      return reportId is string && (
        reportId.matches('^personality_v1_(body|activity|body_activity)$')
        || reportId.matches('^daily_[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
      );
    }

    function hasPaidAccess(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/billing/subscription)
        && get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data.plan == 'paid'
        && (get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data.status == 'active' || get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data.status == 'trialing')
        && (!('currentPeriodEnd' in get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data) || get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data.currentPeriodEnd == null || request.time < get(/databases/$(database)/documents/users/$(uid)/billing/subscription).data.currentPeriodEnd);
    }

    function hasInitialTrialAccess(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/feature_access/initial_trial_v2)
        && get(/databases/$(database)/documents/users/$(uid)/feature_access/initial_trial_v2).data.status == 'active'
        && ('endsAt' in get(/databases/$(database)/documents/users/$(uid)/feature_access/initial_trial_v2).data)
        && request.time < get(/databases/$(database)/documents/users/$(uid)/feature_access/initial_trial_v2).data.endsAt;
    }

    function canCreateRecord(uid) {
      return hasPaidAccess(uid) || hasInitialTrialAccess(uid);
    }

    function validHealthIncidentAction(data) {
      return data.keys().hasOnly([
          'incidentId',
          'acknowledgedAt',
          'snoozedUntil',
          'updatedAt'
        ])
        && data.keys().hasAll(['incidentId', 'updatedAt'])
        && data.incidentId is string
        && data.incidentId.size() > 0
        && data.updatedAt is timestamp
        && (!('acknowledgedAt' in data) || data.acknowledgedAt is timestamp)
        && (!('snoozedUntil' in data) || data.snoozedUntil is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // 現行Flutterが使うroot markerだけClient更新可。
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['has_subcollections'])
        && request.resource.data.keys().hasAll(['has_subcollections'])
        && request.resource.data.has_subcollections is bool;

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['has_subcollections'])
        && request.resource.data.has_subcollections is bool;

      allow delete: if false;

      // Permanent subject identity and the current main-pet profile are
      // committed together by the authenticated profile callable.
      match /pet_profiles/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /mutations/{mutationId} {
          allow read: if isOwner(uid) && docId == 'main_pet';
          allow write: if false;
        }
      }

      match /pet_subjects/{subjectId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /profile_history/{historyId} {
          allow read: if isOwner(uid) && historyId == 'main_profile';
          allow write: if false;
          match /revisions/{revisionId} {
            allow read: if isOwner(uid) && historyId == 'main_profile';
            allow write: if false;
          }
        }
      }

      match /breeding_environments/{docId} {
        allow read: if isOwner(uid);
        // Current values, append-only revisions and mutation receipts commit
        // together through the authenticated environment callable.
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid) && docId == 'main_env';
          allow write: if false;
        }
        match /mutations/{mutationId} {
          allow read: if isOwner(uid) && docId == 'main_env';
          allow write: if false;
        }
      }

      match /owner_profiles/{docId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if isOwner(uid) && docId == 'main';
      }

      // Current measurement and accepted history commit together via callable.
      match /weight_records/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /weight_record_history/{recordId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      match /weight_record_days/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      match /weight_record_mutations/{mutationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /daily_checkins/{docId} {
        allow read: if isOwner(uid);
        // A direct write would bypass the accepted observation history.
        allow write: if false;
      }

      // Observation-day metadata, original events, accepted revisions and
      // receipts are server-owned. Current daily display remains separate.
      match /observation_days/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /events/{eventId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /mutations/{mutationId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Care mutations and their append-only history are accepted atomically
      // by the authenticated callable; direct clients may only read their own.
      match /daily_care_actions/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
        match /mutations/{mutationId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Current measurement and accepted history commit together via callable.
      match /distance_records/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /distance_record_history/{recordId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      match /distance_record_days/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /revisions/{revisionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
      match /distance_record_mutations/{mutationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /settings/notifications {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /app_state/onboarding {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /notification_tokens/{tokenId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /ai_chat_threads/{threadId} {
        allow read, create, update, delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read, create, update, delete: if isOwner(uid);
        }
      }

      match /ai_chat_thread_archives/{archiveId} {
        allow read, create, update, delete: if isOwner(uid);
        match /messages/{messageId} {
          allow read, create, update, delete: if isOwner(uid);
        }
      }

      // AI回答への評価。本人以外は読めない。
      match /ai_answer_feedback/{feedbackId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // SwitchBot secretsはFunctions(Admin SDK)だけ。
      match /integrations/switchbot_secrets {
        allow read, write: if false;
      }

      // Clientは表示用設定を読み、選択した温湿度計メタデータだけ更新可。
      // hasSecrets / enabled / authVersion 等はServer-owned。
      match /integrations/switchbot {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'meterDeviceId',
            'meterDeviceName',
            'meterDeviceType',
            'updatedAt'
          ]);
        allow delete: if false;
      }

      // Server-owned / authoritative
      match /switchbot_readings/{readingId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Acquisition evidence and Silver quality are internal server data.
      // Owners continue reading existing readings; these paths add no client
      // access, including descendants used for immutable outcomes/revisions.
      match /sensor_acquisition_attempts/{document=**} {
        allow read, write: if false;
      }
      match /sensor_polling_state/{document=**} {
        allow read, write: if false;
      }
      match /sensor_quality_snapshots/{document=**} {
        allow read, write: if false;
      }

      match /billing/subscription {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 無料体験の開始日・残回数はFunctionsだけが更新する。
      match /feature_access/trial {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /feature_access/initial_trial_v2 {
        allow read: if isOwner(uid);
        allow write: if false;
        match /ai_usage/{usageId} { allow read, write: if false; }
      }


      // Current-day Insights are server-generated; clients only fetch their own.
      match /individual_insights/{dateKey} {
        allow get: if isOwner(uid);
        allow list, create, update, delete: if false;
      }

      match /analysis_readiness/{metric} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /personalized_reports/{reportId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Server-generated snapshots remain readable by their owner after expiry.
      match /personality_reports/{reportId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      match /report_pointers/personality {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Daily publications never replace the pointer consumed by v1 clients.
      match /report_pointers/personality_daily {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Each successful rendering creates one immutable marker. Reading an old
      // report never changes the read state of the latest report.
      match /report_view_states/{reportId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validPersonalityReportId(reportId)
          && request.resource.data.keys().hasOnly(['reportId', 'viewedAt'])
          && request.resource.data.keys().hasAll(['reportId', 'viewedAt'])
          && request.resource.data.reportId is string
          && request.resource.data.reportId == reportId
          && request.resource.data.viewedAt is timestamp
          && request.resource.data.viewedAt == request.time
          && exists(/databases/$(database)/documents/users/$(uid)/personality_reports/$(reportId))
          && get(/databases/$(database)/documents/users/$(uid)/personality_reports/$(reportId)).data.reportId == reportId;
        allow update, delete: if false;
      }

      match /analysis_events/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /journey_events/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 星の獲得・累計・達成イベントはFunctionsだけが作成・更新する。
      match /star_awards/{awardId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /rewards/stars {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Current-period savings are a server-owned view of existing awards,
      // separate from permanent balance and lifetime achievements.
      match /rewards/continuity {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /continuity_days/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /continuity_credits/{creditId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /continuity_periods/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Prevent a permanent award from being mirrored into multiple periods.
      match /continuity_award_links/{awardId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Pending reward receipts are an internal delivery outbox, not client data.
      match /care_reward_receipts/{receiptId} {
        allow read, write: if false;
      }

      match /condition_award_days/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /star_milestones/{milestoneId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /daily_health_features/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /health_assessments/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /health_assessments_history/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /environment_assessments/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /environment_assessments_history/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /anomaly_notification_logs/{notificationKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /health_incidents/{incidentKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /health_incident_actions/{incidentKey} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validHealthIncidentAction(request.resource.data);
        allow delete: if false;
      }

      // 週次配信上限の原子的カウンター。Functionsだけが操作する。
      match /notification_delivery_counters/{weekKey} {
        allow read, write: if false;
      }

      // 明示していないusers配下はdeny。
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Functionsの定期処理用index。Client不可。
    match /switchbot_users/{uid} {
      allow read, write: if false;
    }

    // Eligible daily-report users are managed only by trusted server code.
    match /personality_report_queue/{uid} {
      allow read, write: if false;
    }

    // Published weight references may be read by signed-in clients for current
    // analysis. Discovery/listing and all management remain server-only.
    match /reference_cohorts/{cohortId} {
      function publishedWeightReference(data) {
        return data.cohortId == cohortId
          && data.sourceType == 'published_research'
          && data.metric == 'weight'
          && data.unit == 'g';
      }

      allow get: if signedIn()
        && publishedWeightReference(resource.data)
        && resource.data.currentReferenceVersion is string
        && resource.data.currentReferenceVersion.size() > 0;
      allow list, write: if false;

      match /versions/{versionId} {
        allow get: if signedIn()
          && publishedWeightReference(resource.data)
          && resource.data.referenceVersion == versionId;
        allow list, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
